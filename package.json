{
  "name": "koken-sync-manager",
  "version": "1.3.0",
  "description": "Desktop sync manager (koken Sync Manager)",
  "author": "koken",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/renderer', 'dist/renderer', {recursive: true}); require('fs').cpSync('assets', 'dist/assets', {recursive: true})\"",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "chcp 65001 >nul && tsc && electron ."
  },
  "dependencies": {
    "basic-ftp": "^6.2.1",
    "webdav": "^5.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
